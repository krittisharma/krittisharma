source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "jekyll-sitemap"

# Ruby 3.0+ removed webrick from the standard library; `jekyll serve` needs it.
gem "webrick", "~> 1.8"

# Windows/JRuby compatibility (harmless on other platforms)
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
end
